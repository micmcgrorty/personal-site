{
	"name": "personal-site",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --watch --import remix/node-tsx server.ts",
		"start": "NODE_ENV=production node --import remix/node-tsx server.ts",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"type-check": "tsc --noEmit",
		"test": "remix test"
	},
	"dependencies": {
		"remix": "^3.1.0"
	},
	"devDependencies": {
		"@types/node": "latest",
		"oxfmt": "^0.77.0",
		"oxlint": "^1.92.0",
		"typescript": "latest"
	},
	"engines": {
		"node": ">=24.3.0"
	}
}
